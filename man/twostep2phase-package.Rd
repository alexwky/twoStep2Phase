\name{twoStep2Phase-package}
\alias{twoStep2Phase-package}
\alias{twoStep2Phase}
\title{Two-Step Estimation for Two-Phase Studies}
\description{
Utilities and prototype estimators for the update-estimation approach in
"An optimal two-step estimation approach for two-phase studies".
}
\details{
The package provides one generator and one automatic analysis function for
each of the linear, logistic, and Cox settings. Analyses without cheap
covariates use the optimal approach; analyses with columns named \code{Z1},
\code{Z2}, and so on use the joint approach.
}
\keyword{package}
